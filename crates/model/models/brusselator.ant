/*
[bifurcation]
parameter: B
min: 1
max: 3
ds: 0.001
dsMax: 0.02
maxSteps: 4000
*/

// BRUSSELATOR - the standard first check of any Hopf detector.
//
//   J1:  -> X       A
//   J2:  X -> Y     B X
//   J3:  Y -> X     X^2 Y
//   J4:  X ->       X
//
//   Run:  parameter B, range 1 : 3, plot Y
//
// The equilibrium is X = A, Y = B/A for every B, so plotted against X the
// branch is a flat line; plot Y. The Hopf is at B = 1 + A^2 = 2 with
// omega = A = 1, and l1 = -0.5 (supercritical) under Kuznetsov's
// normalisation.
//
// Because omega = 1 here, this model cannot tell apart the two common
// normalisations of l1 (ours and MatCont's differ by a factor of omega).
// The same system is also built into the library as a native model.
//
// From the BifurcationTool example library.

model brusselator
    J1: -> X;    A;
    J2: X -> Y;  B*X;
    J3: Y -> X;  X^2*Y;
    J4: X -> ;   X;

    A = 1;
    B = 1;
    X = 1;
    Y = 1;
end
